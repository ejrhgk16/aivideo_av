          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Default sort returns the latest catalog\", () => {",
              "  pm.expect(pm.response.json()).to.deep.equal(JSON.parse(pm.collectionVariables.get(\"catalog\")));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/dramas"
      }
    },
    {
      "name": "Invalid drama sort",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unsupported sort returns the documented HTTP 400\", () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json()).to.deep.equal({",
              "    statusCode: 400, error: \"Bad Request\", message: \"sort must be latest\"",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/dramas?sort=invalid"
      }
    },
    {
      "name": "Drama detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "",
              "const detail = pm.response.json();",
              "const summary = JSON.parse(pm.collectionVariables.get(\"selectedDrama\"));",
              "pm.test(\"Detail agrees with catalog fields\", () => {",
              "  [\"uuid\", \"slug\", \"title\", \"shortDescription\", \"productionCompany\", \"genres\", \"imageUrls\", \"previewVideos\"].forEach(key => {",
              "    pm.expect(detail[key], key).to.deep.equal(summary[key]);",
              "  });",
              "  pm.expect(detail.synopsis).to.be.a(\"string\");",
              "});",
              "pm.test(\"Public episode counts, ordering, and prices agree with the catalog\", () => {",
              "  pm.expect(detail.episodes).to.be.an(\"array\");",
              "  pm.expect(detail.episodes.length).to.equal(summary.episodeCount);",
              "  pm.expect(detail.episodes.filter(episode => episode.pricePoints === 0).length).to.equal(summary.freeEpisodeCount);",
              "  const numbers = detail.episodes.map(episode => episode.episodeNumber);",
              "  pm.expect(numbers).to.deep.equal([...numbers].sort((a, b) => a - b));",
              "  pm.expect(new Set(numbers).size).to.equal(numbers.length);",
              "  detail.episodes.forEach(episode => {",
              "    pm.expect(episode.videoUuid === null || typeof episode.videoUuid === \"string\").to.equal(true);",
              "    pm.expect(episode.isSaved).to.be.a(\"boolean\");",
              "    pm.expect(episode.isUnlocked).to.be.a(\"boolean\");",
              "    pm.expect(episode.episodeNumber).to.satisfy(Number.isInteger).and.be.above(0);",
              "    pm.expect(episode.pricePoints).to.satisfy(Number.isInteger).and.be.at.least(0);",
              "    pm.expect(episode.durationMs).to.satisfy(Number.isInteger).and.be.above(0);",
              "    pm.expect(episode.title === null || typeof episode.title === \"string\").to.equal(true);",
              "    pm.expect(episode.synopsis === null || typeof episode.synopsis === \"string\").to.equal(true);",
              "    pm.expect(episode.image === null || typeof episode.image === \"string\").to.equal(true);",
              "    pm.expect(episode).to.have.property(\"watchProgress\");",
              "    if (episode.watchProgress !== null) {",
              "      pm.expect(episode.watchProgress.positionMs).to.satisfy(Number.isInteger).and.be.at.least(0);",
              "      pm.expect(episode.watchProgress.isCompleted).to.be.a(\"boolean\");",
              "      pm.expect(new Date(episode.watchProgress.lastPlayedAt).toISOString()).to.equal(episode.watchProgress.lastPlayedAt);",
              "    }",
              "  });",
              "});",
              "const free = detail.episodes.find(episode => episode.pricePoints === 0);",
              "const paid = detail.episodes.find(episode => episode.pricePoints > 0);",
              "pm.test(\"Detail supplies both playback test cases\", () => {",
              "  pm.expect(free).to.exist;",
              "  pm.expect(paid).to.exist;",
              "});",
              "if (free && paid) {",
              "  pm.collectionVariables.set(\"freeEpisode\", JSON.stringify(free));",
              "  pm.collectionVariables.set(\"paidEpisode\", JSON.stringify(paid));",
              "  pm.collectionVariables.set(\"freeEpisodeId\", free.uuid);",
              "  pm.collectionVariables.set(\"paidEpisodeId\", paid.uuid);",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/dramas/{{dramaId}}"
      }
    },
    {
      "name": "Drama detail for entitled user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const detail = pm.response.json();",
              "const owned = detail.episodes.find(e => e.uuid === pm.variables.get(\"entitledEpisodeUuid\"));",
              "const locked = detail.episodes.find(e => e.uuid === pm.variables.get(\"lockedEpisodeUuid\"));",
              "const progressEpisodeUuid = pm.variables.get(\"watchProgressEpisodeUuid\");",
              "const progressEpisode = detail.episodes.find(e => e.uuid === progressEpisodeUuid);",
              "pm.test(\"The user's paid entitlement unlocks only owned episodes\", () => {",
              "  pm.expect(owned).to.be.an(\"object\");",
              "  pm.expect(owned.pricePoints).to.be.above(0);",
              "  pm.expect(owned.isUnlocked).to.equal(true);",
              "  pm.expect(locked).to.be.an(\"object\");",
              "  pm.expect(locked.pricePoints).to.be.above(0);",
              "  pm.expect(locked.isUnlocked).to.equal(false);",
              "  const free = detail.episodes.filter(e => e.pricePoints === 0);",
              "  pm.expect(free.length).to.be.above(0);",
              "  free.forEach(e => pm.expect(e.isUnlocked).to.equal(true));",
              "});",
              "pm.collectionVariables.set(\"fixtureEntitledEpisode\", JSON.stringify(owned));",
              "pm.test(\"Configured existing watch progress matches its SELECT fixture\", () => {",
              "  pm.expect(progressEpisodeUuid, \"Set watchProgress* variables from an existing DB row\").to.match(/^[0-9a-f-]{36}$/i);",
              "  pm.expect(progressEpisode).to.be.an(\"object\");",
              "  pm.expect(progressEpisode.watchProgress).to.deep.equal({",
              "    positionMs: Number(pm.variables.get(\"watchProgressPositionMs\")),",
              "    isCompleted: pm.variables.get(\"watchProgressIsCompleted\") === \"true\",",
              "    lastPlayedAt: pm.variables.get(\"watchProgressLastPlayedAt\"),",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{entitledAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/dramas/{{entitlementDramaUuid}}"
      }
    },
    {
      "name": "Drama detail for unentitled user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const detail = pm.response.json();",
              "const owned = detail.episodes.find(e => e.uuid === pm.variables.get(\"entitledEpisodeUuid\"));",
              "const progressEpisodeUuid = pm.variables.get(\"watchProgressEpisodeUuid\");",
              "const progressEpisode = detail.episodes.find(e => e.uuid === progressEpisodeUuid);",
              "pm.test(\"Another user's entitlement and watch progress are not exposed\", () => {",
              "  pm.expect(owned).to.be.an(\"object\");",
              "  pm.expect(owned.isUnlocked).to.equal(false);",
              "  pm.expect(progressEpisode).to.be.an(\"object\");",
              "  pm.expect(progressEpisode.watchProgress).to.equal(null);",
              "  const free = detail.episodes.filter(e => e.pricePoints === 0);",
              "  pm.expect(free.length).to.be.above(0);",
              "  free.forEach(e => pm.expect(e.isUnlocked).to.equal(true));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{unentitledAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/dramas/{{entitlementDramaUuid}}"
      }
    },
    {
      "name": "Drama detail without user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const detail = pm.response.json();",
              "const progressEpisodeUuid = pm.variables.get(\"watchProgressEpisodeUuid\");",
              "const progressEpisode = detail.episodes.find(e => e.uuid === progressEpisodeUuid);",
              "pm.test(\"Without user, only free episodes are unlocked and progress is null\", () => {",
              "  pm.expect(detail.episodes.length).to.be.above(0);",
