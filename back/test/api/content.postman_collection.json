              "  detail.episodes.filter(e => e.pricePoints === 0).forEach(e => pm.expect(e.isUnlocked).to.equal(true));",
              "  detail.episodes.filter(e => e.pricePoints > 0).forEach(e => pm.expect(e.isUnlocked).to.equal(false));",
