    {
      "name": "Login as entitled fixture user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Entitled fixture login succeeds',()=>{const b=pm.response.json();pm.response.to.have.status(200);pm.expect(b.uuid).to.equal(pm.variables.get('entitledUserUuid'));pm.expect(b.accessToken).to.be.a('string').and.not.empty;pm.collectionVariables.set('entitledAccessToken',b.accessToken);});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"loginId\":\"{{entitledLoginId}}\",\"password\":\"{{entitledPassword}}\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
