{
  "info": {
    "name": "AI Drama public API",
    "description": "HTTP checks against the running development API and its MySQL database. Requires public dramas with free/paid episodes and previews, plus the documented zero-balance point error fixture. Does not download signed media URLs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "entitledLoginId",
      "value": "",
      "type": "string"
    },
    {
      "key": "entitledPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "unentitledLoginId",
      "value": "",
      "type": "string"
    },
    {
      "key": "unentitledPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "entitledAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "unentitledAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "entitledRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "unentitledRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "entitledUserUuid",
      "value": "00000010-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "unentitledUserUuid",
      "value": "00000012-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "entitlementDramaUuid",
      "value": "00000002-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "entitledEpisodeUuid",
      "value": "00000004-0000-4000-8000-000000000002",
      "type": "string"
    },
    {
      "key": "lockedEpisodeUuid",
      "value": "00000004-0000-4000-8000-000000000003",
      "type": "string"
    },
    {
      "key": "purchaseTestEpisodeUuid",
      "value": "00000004-0000-4000-8000-000000000004",
      "type": "string"
    },
    {
      "key": "watchProgressEpisodeUuid",
      "value": "00000004-0000-4000-8000-000000000003",
      "type": "string"
    },
    {
      "key": "watchProgressPositionMs",
      "value": "0",
      "type": "string"
    },
    {
      "key": "watchProgressIsCompleted",
      "value": "false",
      "type": "string"
    },
    {
      "key": "watchProgressLastPlayedAt",
      "value": "2026-10-28T00:00:00.000Z",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"API does not return a server error\", () => {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "if (pm.response.code === 200 && pm.info.requestName !== \"Root\" && /application\\/json/i.test(pm.response.headers.get(\"Content-Type\") || \"\")) {",
          "  pm.test(\"Public response shapes and identifiers follow the API contract\", () => {",
          "    const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
          "    function check(value) {",
          "      if (Array.isArray(value)) return value.forEach(check);",
          "      if (!value || typeof value !== \"object\") return;",
          "      if (\"uuid\" in value) {",
          "        pm.expect(value.uuid).to.match(uuid);",
          "        pm.expect(value).not.to.have.property(\"id\");",
          "      }",
          "      if (\"imageUrls\" in value) {",
          "        [\"slug\", \"title\", \"shortDescription\"].forEach(key => pm.expect(value[key], key).to.be.a(\"string\"));",
          "        pm.expect(value).not.to.have.property(\"images\");",
          "        [\"poster\", \"posterLandscape\", \"homeHero\", \"detailCover\"].forEach(key => {",
          "          const url = value.imageUrls[key];",
          "          pm.expect(url === null || (typeof url === \"string\" && /^https:\\/\\//.test(url)), key).to.equal(true);",
          "        });",
          "        pm.expect(value.imageUrls.campaigns).to.be.an(\"array\");",
          "        value.imageUrls.campaigns.forEach(url => pm.expect(url).to.match(/^https:\\/\\//));",
          "        pm.expect(value.previewVideos).to.be.an(\"array\");",
          "        value.previewVideos.forEach(video => {",
          "          pm.expect(video.storageKey).to.be.a(\"string\").and.not.be.empty;",
          "          pm.expect(video.durationMs).to.satisfy(Number.isInteger).and.be.above(0);",
          "          pm.expect(video.isSaved).to.be.a(\"boolean\");",
          "        });",
          "        pm.expect(value.genres).to.be.an(\"array\");",
          "        const genreIds = JSON.parse(pm.collectionVariables.get(\"genreIds\"));",
          "        value.genres.forEach(genre => {",
          "          pm.expect(genreIds).to.include(genre.id);",
          "          pm.expect(genre.code).to.be.a(\"string\");",
          "          pm.expect(genre.name).to.be.a(\"string\");",
          "        });",
          "        const count = value.episodeCount ?? value.publishedEpisodeCount;",
          "        if (count !== undefined) {",
          "          pm.expect(count).to.satisfy(Number.isInteger).and.be.at.least(0);",
          "          pm.expect(value.freeEpisodeCount).to.satisfy(Number.isInteger).and.be.within(0, count);",
          "        }",
          "      }",
          "      Object.values(value).forEach(check);",
          "    }",
          "    check(pm.response.json());",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Root",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "[\"catalog\", \"selectedDrama\", \"dramaId\", \"otherDramaId\", \"previewId\", \"freeEpisode\", \"paidEpisode\", \"freeEpisodeId\", \"paidEpisodeId\", \"genreIds\"].forEach(key => pm.collectionVariables.unset(key));",
              "pm.collectionVariables.set(\"missingId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Root responds\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.text()).to.equal(\"Hello World!\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Allowed CORS origin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Development web origin is allowed\", () => {",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.equal(\"http://localhost:8081\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:8081"
          }
        ],
        "url": "{{baseUrl}}/genres"
      }
    },
    {
      "name": "Rejected CORS origin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Another web origin receives no CORS permission\", () => {",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.not.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:8082"
          }
        ],
        "url": "{{baseUrl}}/genres"
      }
    },
    {
      "name": "CORS preflight",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Preflight allows the development origin and GET\", () => {",
              "  pm.response.to.have.status(204);",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.equal(\"http://localhost:8081\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"GET\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Credentials\")).to.equal(\"true\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:8081"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "GET"
          }
        ],
        "url": "{{baseUrl}}/genres"
      }
    },
    {
      "name": "Point increase preflight",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Preflight allows the development origin and POST\", () => {",
              "  pm.response.to.have.status(204);",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.equal(\"http://localhost:8081\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Credentials\")).to.equal(\"true\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Headers\").toLowerCase()).to.include(\"x-auth-transport\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Headers\").toLowerCase()).to.include(\"authorization\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:8081"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "POST"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "authorization,content-type"
          }
        ],
        "url": "{{baseUrl}}/me/points/increase"
      }
    },
    {
      "name": "Single episode purchase preflight",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Preflight allows the development origin and POST\", () => {",
              "  pm.response.to.have.status(204);",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.equal(\"http://localhost:8081\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\");",
              "  pm.expect(pm.response.headers.get(\"Access-Control-Allow-Headers\").toLowerCase()).to.include(\"authorization\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:8081"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "POST"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "authorization,content-type"
          }
        ],
        "url": "{{baseUrl}}/me/episodes/00000020-0000-4000-8000-000000000001/purchaseSingle"
      }
    }
  ]
}
