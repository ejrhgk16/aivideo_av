    {
      "name": "Collection HOME_FEATURED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "",
              "const collection = pm.response.json();",
              "const catalog = JSON.parse(pm.collectionVariables.get(\"catalog\"));",
              "pm.test(\"Collection HOME_FEATURED has its documented envelope\", () => {",
              "  pm.expect(collection.code).to.equal(\"HOME_FEATURED\");",
              "  pm.expect(collection.title).to.be.a(\"string\");",
              "  pm.expect(collection.description === null || typeof collection.description === \"string\").to.equal(true);",
              "  pm.expect(collection.dramas).to.be.an(\"array\");",
              "});",
              "pm.test(\"Collection order and public summaries agree with the catalog\", () => {",
              "  const orders = collection.dramas.map(drama => drama.displayOrder);",
              "  pm.expect(orders).to.deep.equal([...orders].sort((a, b) => a - b));",
              "  pm.expect(new Set(collection.dramas.map(drama => drama.uuid)).size).to.equal(collection.dramas.length);",
              "  collection.dramas.forEach(drama => {",
              "    pm.expect(drama.displayOrder).to.satisfy(Number.isInteger);",
              "    const summary = catalog.find(item => item.uuid === drama.uuid);",
              "    pm.expect(summary, \"Collection must only contain public catalog dramas\").to.exist;",
              "    [\"slug\", \"title\", \"shortDescription\", \"imageUrls\", \"previewVideos\"].forEach(key => {",
              "      pm.expect(drama[key], key).to.deep.equal(summary[key]);",
              "    });",
              "    pm.expect(drama.genres.map(genre => genre.id).sort()).to.deep.equal(summary.genres.map(genre => genre.id).sort());",
              "    pm.expect(drama.publishedEpisodeCount).to.equal(summary.episodeCount);",
              "    pm.expect(drama.freeEpisodeCount).to.equal(summary.freeEpisodeCount);",
              "    pm.expect(drama.productionCompany ? drama.productionCompany.name : null).to.equal(summary.productionCompany);",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/collections/HOME_FEATURED"
      }
    },
