        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Root responds\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.text()).to.equal(\"Hello World!\");",
              "});"
            ]
          }
        }
      ],
